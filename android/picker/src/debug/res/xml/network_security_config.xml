<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only configuration: allows cleartext HTTP to localhost / LAN for local development. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

