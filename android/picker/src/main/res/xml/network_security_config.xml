<?xml version="1.0" encoding="utf-8"?>
<!-- Release configuration: cleartext HTTP disallowed; TLS (HTTPS/WSS) required. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
