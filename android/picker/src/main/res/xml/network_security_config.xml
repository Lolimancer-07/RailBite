<?xml version="1.0" encoding="utf-8"?>
<!-- Allows both TLS (HTTPS/WSS cloud) and cleartext HTTP/WS for onboard/laptop LAN servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
