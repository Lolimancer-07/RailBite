<?xml version="1.0" encoding="utf-8"?>
<!-- PROTOTYPE ONLY: plain cleartext HTTP to the edge server on the pantry/laptop LAN.
     A production deployment would serve TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
