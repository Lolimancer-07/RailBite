# Build-time default server URL (replace with your laptop's LAN IP)
# Find it with: hostname -I (Linux) or ipconfig getifaddr en0 (macOS)
EXPO_PUBLIC_SERVER_URL=http://192.168.1.100:8080

# Optional: override MQTT WebSocket port (default 8883)
# EXPO_PUBLIC_MQTT_WS_PORT=8883

# Optional: trip ID
# EXPO_PUBLIC_TRIP_ID=TRIP_001
